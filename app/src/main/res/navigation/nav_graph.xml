<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainStartFragment">

    <fragment
        android:id="@+id/mainStartFragment"
        android:name="com.example.demonavigation.MainStartFragment"
        android:label="Màn hình chính">
        <action
            android:id="@+id/action_mainStartFragment_to_viewPageHahaFragment"
            app:destination="@id/viewPageHahaFragment" />
        <action
            android:id="@+id/action_mainStartFragment_to_concatAdapterDemoFragment"
            app:destination="@id/concatAdapterDemoFragment" />
    </fragment>

    <fragment
        android:id="@+id/concatAdapterDemoFragment"
        android:name="com.example.demonavigation.ConcatAdapterDemoFragment"
        android:label="ConcatAdapter Demo" />

    <fragment
        android:id="@+id/viewPageHahaFragment"
        android:name="com.example.demonavigation.ViewPageHahaFragment"
        android:label="ViewPager Haha">
        <action
            android:id="@+id/action_viewPageHahaFragment_to_tradeFragment"
            app:destination="@id/tradeFragment" />
    </fragment>

    <fragment
        android:id="@+id/tradeFragment"
        android:name="com.example.demonavigation.TradeFragment"
        android:label="Trade" />

    <fragment
        android:id="@+id/firstFragment"
        android:name="com.example.demonavigation.FirstFragment"
        android:label="@string/first_fragment_title">
        <action
            android:id="@+id/action_firstFragment_to_secondFragment"
            app:destination="@id/secondFragment" />
        <action
            android:id="@+id/action_firstFragment_to_cameraFragment"
            app:destination="@id/cameraFragment" />
    </fragment>

    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.example.demonavigation.CameraFragment"
        android:label="@string/camera_fragment_title" />

    <fragment
        android:id="@+id/secondFragment"
        android:name="com.example.demonavigation.SecondFragment"
        android:label="@string/details_fragment_title">
        <argument
            android:name="userName"
            app:argType="string" />
        <action
            android:id="@+id/action_secondFragment_to_thirdFragment"
            app:destination="@id/thirdFragment" />
        <action
            android:id="@+id/action_secondFragment_to_firstFragment"
            app:destination="@id/firstFragment"
            app:popUpTo="@id/firstFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/thirdFragment"
        android:name="com.example.demonavigation.ThirdFragment"
        android:label="@string/third_fragment_title">
        <action
            android:id="@+id/action_thirdFragment_to_firstFragment"
            app:destination="@id/firstFragment"
            app:popUpTo="@id/firstFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
